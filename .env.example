# ==============================================================================
# Cloud-Based Intelligent Inventory Management & Stock Prediction System
# Environment Configuration Template
# ==============================================================================

# Application Runtime Mode: "local" (zero-cost SQLite/Mock) or "aws" (DynamoDB, Cognito, S3)
STORAGE_MODE=local
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Cloud Settings (Used when STORAGE_MODE=aws)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=InventoryManagementTable
S3_REPORTS_BUCKET=inventory-reports-mtech-storage
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_APP_CLIENT_ID=exampleappclientid1234567890

# Machine Learning & Demand Forecasting Settings
FORECAST_METHOD=exponential_smoothing  # Options: moving_average, weighted_moving_average, exponential_smoothing
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SAFETY_STOCK_FACTOR=1.65  # Standard 95% service level factor
FORECAST_HORIZON_DAYS=30

# Demo & Seed Controls
ENABLE_DEMO_SEED=true
DEMO_USER_ROLE=Admin  # Admin or Staff
